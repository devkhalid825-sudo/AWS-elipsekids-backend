PORT=5006
NODE_ENV=production

# MySQL (create the database + user with deploy/setup.sql first).
# If the password has special characters, URL-encode them (e.g. @ -> %40).
DATABASE_URL="mysql://elipse_user:REPLACE_WITH_STRONG_PASSWORD@localhost:3306/elipse_kids_db"

# Admin login for /admin on the website. CHANGE THESE.
ADMIN_NAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# Long random string used to sign admin tokens:  openssl rand -hex 32
TOKEN_SECRET=REPLACE_WITH_RANDOM_HEX

# Website origins allowed to call this API (comma separated, no trailing slash)
CORS_ORIGIN=https://maryamandzayn.com,https://www.maryamandzayn.com

# Where uploaded images/videos are stored (default: ./uploads)
# UPLOAD_DIR=/var/www/elipse-kids-backend/uploads

# Partner inquiries are always saved. To ALSO email them, fill SMTP:
INQUIRY_TO=info@elipsekids.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
